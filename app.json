{
  "expo": {
    "name": "PoolShare",
    "slug": "pool-sharing",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/1024.png",
    "scheme": "poolshare",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/1024.png",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow PoolShare to access your photo library to upload vehicle photos.",
        "NSDocumentsFolderUsageDescription": "Allow PoolShare to access your documents folder to upload RC certificates."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pintu7787.carpooling",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icons/favicon.png"
    },
    "plugins": [
      "expo-image",
      "expo-web-browser",
      "expo-font",
      "expo-status-bar",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#020817",
          "image": "./assets/images/notification-icon.png",
          "imageWidth": 135,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Car Pooling to use your location to find nearby rides."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/ic_stat_icons8_car_64_1.png",
          "color": "#ffffff"
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyCUXqyqz3g5znIwsuaGP6qeGPkNxK5ZChg"
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "68ee12f4-35d7-4123-9032-865c39e14d58"
      }
    },
    "owner": "maastrix01"
  }
}